{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kienhoc",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NODE_ENV": "production",
    "TRUST_PROXY_HOPS": "1",
    "APP_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787"
  },
  "ratelimits": [{
    "name": "AUTH_LIMITER", "namespace_id": "1001",
    "simple": { "limit": 60, "period": 60 }
  }]
}
