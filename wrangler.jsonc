{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kienhoc",
  "account_id": "dea1d41355c5cb6bd9c128f72ec85a0f",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "hyperdrive": [{"binding":"HYPERDRIVE","id":"90035687e0384e4c9f27530c6cf88e0e"}],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NODE_ENV": "production",
    "TRUST_PROXY_HOPS": "1",
    "APP_ORIGINS": "https://kienhoc.anhdungcasi.workers.dev"
  },
  "ratelimits": [{
    "name": "AUTH_LIMITER", "namespace_id": "1001",
    "simple": { "limit": 60, "period": 60 }
  }]
}
